<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsOpen">
      <Children>
        <!-- Cláudio's reply now shows in the vanilla conversation nameplate itself (see
             DialogTextPatch — a Harmony patch redirects its DialogText to our text while this
             chat is open), so this panel is just the free-text input the vanilla screen has no
             widget for. Positioned right above that vanilla box, not overlapping it. -->
        <Widget WidthSizePolicy="Fixed" SuggestedWidth="700"
                HeightSizePolicy="Fixed" SuggestedHeight="120"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                MarginRight="40" MarginBottom="100"
                Sprite="npc_dialogue_panel_9">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30"
                    VerticalAlignment="Top" MarginTop="8" MarginLeft="16" MarginRight="16">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Text="Você diz:" Brush="Conversation.HeaderText" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="12"
                            Text="Cláudio está pensando..." IsVisible="@IsWaitingForReply"
                            Brush="GameTip.Text" />
                <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="70"
                              HeightSizePolicy="StretchToParent"
                              HorizontalAlignment="Right"
                              Command.Click="ExecuteClose" Brush="ButtonSimpleBrush">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Text="Fechar" Brush="GameTip.Text" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="66"
                    VerticalAlignment="Bottom" MarginBottom="14" MarginLeft="16" MarginRight="16">
              <Children>
                <EditableTextWidget Id="ChatInput" WidthSizePolicy="StretchToParent"
                                     HeightSizePolicy="Fixed" SuggestedHeight="42"
                                     VerticalAlignment="Center" MarginRight="86"
                                     Text="@InputText" Brush="CustomBattle.Search.TextBox"
                                     MaxLength="500" Command.TextEntered="ExecuteSend" />
                <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="70"
                              HeightSizePolicy="Fixed" SuggestedHeight="42"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Command.Click="ExecuteSend" Brush="ButtonSimpleBrush"
                              IsEnabled="@CanSend">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Text="Enviar" Brush="GameTip.Text" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
