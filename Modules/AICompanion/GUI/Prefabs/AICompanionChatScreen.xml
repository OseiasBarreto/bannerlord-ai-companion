<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsOpen">
      <Children>
        <!-- dimmed backdrop — a plain Widget's Brush didn't reliably paint in this hosting
             context (only interactive widgets did), so background panels now use a direct
             Sprite attribute instead of a named Brush, matching how vanilla prefabs draw
             static background panels (e.g. CharacterCreationClanNamingStage.xml). -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9" Color="#000000B0" />

        <Widget WidthSizePolicy="Fixed" SuggestedWidth="700"
                HeightSizePolicy="Fixed" SuggestedHeight="820"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#1A1712F0">
          <Children>
            <!-- title bar -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="60"
                    VerticalAlignment="Top">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Text="@Title" Brush="FullScreenNotice.Title" />
                <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="40"
                              HeightSizePolicy="Fixed" SuggestedHeight="40"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Command.Click="ExecuteClose" Brush="ButtonSimpleBrush" />
              </Children>
            </Widget>

            <!-- message history -->
            <ListPanel Id="ChatHistory" WidthSizePolicy="StretchToParent"
                       HeightSizePolicy="Fixed" SuggestedHeight="640"
                       VerticalAlignment="Top" MarginTop="60"
                       StackLayout.LayoutMethod="VerticalBottomToTop"
                       DataSource="{Messages}">
              <ItemTemplate>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        MarginBottom="10">
                  <Children>
                    <TextWidget Text="@Text"
                                WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                HorizontalAlignment="Left"
                                Brush="FullScreenNotice.Text" />
                  </Children>
                </Widget>
              </ItemTemplate>
            </ListPanel>

            <!-- waiting indicator -->
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20"
                        VerticalAlignment="Bottom" MarginBottom="70"
                        HorizontalAlignment="Center"
                        Text="Cláudio está pensando..."
                        IsVisible="@IsWaitingForReply"
                        Brush="GameTip.Text" />

            <!-- input row -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="60"
                    VerticalAlignment="Bottom">
              <Children>
                <EditableTextWidget Id="ChatInput" WidthSizePolicy="StretchToParent"
                                     HeightSizePolicy="StretchToParent" MarginRight="90"
                                     Text="@InputText" Brush="CustomBattle.Search.TextBox"
                                     MaxLength="500" Command.TextEntered="ExecuteSend" />
                <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="80"
                              HeightSizePolicy="StretchToParent" HorizontalAlignment="Right"
                              Command.Click="ExecuteSend" Brush="ButtonSimpleBrush"
                              IsEnabled="@CanSend" />
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
